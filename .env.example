# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=temp_chat

# Security
SECRET_KEY=
ENCRYPTION_KEY=

# Session rules
REQUEST_EXPIRY_DAYS=7
UNREAD_EMAIL_DELAY_MINUTES=5

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Storage (S3/MinIO)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=temp-chat-uploads

# Public URL of this deployment, used to build chat links
PUBLIC_BASE_URL=http://localhost:8000

# Development only. Takes the consultee identity from request headers
# instead of an SSO session. Must be false anywhere real.
DEV_AUTH_STUB=false
